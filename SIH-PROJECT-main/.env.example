# PowerSight Environment Configuration Template
# Copy this file to .env and fill in your real credentials.

PORT=5000

# OneSignal Configuration
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here

# Supabase Telemetry Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_or_anon_key_here
